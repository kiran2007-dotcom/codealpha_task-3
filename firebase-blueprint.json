          "type": "boolean"
        },
        "likesCount": {
          "type": "integer"
        },
        "commentsCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "authorUsername",
        "authorName",
        "authorAvatarUrl",
        "content",
        "imageUrl",
        "hashtags",
        "visibility",
        "isDemo",
        "likesCount",
        "commentsCount",
        "createdAt",
        "updatedAt"
      ]
    },
