        "authorUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorAvatarUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "content": {
          "type": "string",
          "maxLength": 2000
