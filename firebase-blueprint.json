{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public social profile information for a ConnectSphere user (zero PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "usernameLower": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fullNameLower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "maxLength": 280
        },
        "location": {
          "type": "string",
          "maxLength": 80
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "postsCount": {
          "type": "integer"
        },
        "followersCount": {
          "type": "integer"
        },
        "followingCount": {
          "type": "integer"
        },
        "isPublic": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "usernameLower",
        "fullName",
        "fullNameLower",
        "bio",
        "location",
        "avatarUrl",
        "coverUrl",
        "postsCount",
        "followersCount",
        "followingCount",
        "isPublic",
        "isDemo",
        "joinedAt",
        "updatedAt"
      ]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Isolated private account PII accessible strictly by the account owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique username reservation record mapping lowercase username to uid.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "createdAt"
      ]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed post authored by a verified user or labeled demo account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
